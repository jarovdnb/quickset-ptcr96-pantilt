[Unit]
Description=Pan-Tilt Dashboard Service
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/pi/quickset-ptcr96-pantilt/pantilt-dashboard/app_pantilt.py
WorkingDirectory=/home/pi/quickset-ptcr96-pantilt/pantilt-dashboard
Restart=always
RestartSec=30
User=pi
Environment=DISPLAY=:0

[Install]
WantedBy=multi-user.target
